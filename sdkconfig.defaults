# Source of truth for the ESP-IDF configuration. sdkconfig.<env> is generated
# from this on every build and is gitignored.
#
# To change something: `pio run -t menuconfig`, then `pio run -t save-defconfig`
# to rewrite this file. save-defconfig drops these comments and also writes out
# settings inherited from arduino-esp32's own defaults (speech recognition,
# RainMaker, Modbus) -- diff before committing and keep only what the cube needs.

# Updates: a new image boots "pending verify" and Cube::init() confirms it once
# the display, WiFi and the first pattern are up. If it crashes or resets
# before that, the bootloader goes back to the previous image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Crash dumps go to the 64 KB coredump partition, to be read back over USB
# with esp-coredump (`esp-coredump info_corefile -c <dump> firmware.elf`).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Target and flash
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="min_spiffs_s3.csv"
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16

# Arduino as a component: setup()/loop() start from Arduino's app_main.
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_RUN_NO_AFFINITY=y
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL_INFO=y

# Optimize for speed. The IDF default (-Og) is for debugging; the render loop's
# per-pixel work runs measurably faster at -O2.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Assertions still stop the cube, but without compiling in each one's file
# name and expression: about 59 KB, which keeps the image inside the 0x1E0000
# app slots of cubes still on the old partition table (scripts/size_guard.py).
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# CPU, RTOS, console
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# Octal PSRAM (N16R8 module). Large buffers -- album art, JSON documents, the
# snake board -- live here; small allocations stay internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Networking
CONFIG_LWIP_LOCAL_HOSTNAME="cube"
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP6_REASSEMBLY=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512

# TLS (GitHub updates, Spotify)
CONFIG_ESP_TLS_PSK_VERIFICATION=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# No CONFIG_MBEDTLS_DEBUG: ESP-IDF's TLS layer (the MQTT client's) turns it
# into a dozen log lines per TLS record, which on the USB-Serial-JTAG console
# block whenever no host is reading.
# CONFIG_MBEDTLS_DEBUG is not set
